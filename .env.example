# Neon connection string (pooled). Create the project at https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string

# Public site URL, used to build invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional managed real-time provider. Leave empty to use built-in polling.
REALTIME_PROVIDER=polling
# ABLY_API_KEY=
